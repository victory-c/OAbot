# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OABOT_MODEL=claude-opus-5-5
OABOT_TZ=America/Los_Angeles

# bCourses -> Calendar -> "Calendar Feed" link (optional; mock deadlines are used if empty)
BCOURSES_ICS_URL=

# Optional: Discord channel webhook for "I blocked Thu 7-9pm" pings
DISCORD_WEBHOOK_URL=

# Gmail polling
OABOT_POLL_SECONDS=15
OABOT_GMAIL_QUERY=newer_than:1d -category:promotions -category:social

# Treat a repeat email about the same OA or interview as a reminder (no new block). Set to 0 to schedule every email.
OABOT_DEDUPE=1
