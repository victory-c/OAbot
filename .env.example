# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OABOT_MODEL=claude-opus-5-5
OABOT_TZ=America/Los_Angeles
# Base URL of the dashboard, used for the prep/warm-up links inside calendar events. Change it if you run on another port or host.
OABOT_PUBLIC_URL=http://localhost:8000

# Coursework deadlines: bCourses -> Calendar -> "Calendar Feed" (bottom right), paste the .ics link (https:// or webcal://). Empty = mock deadlines. Check with: python -m app.bcourses
BCOURSES_ICS_URL=

# Phone pings ("Blocked Thu 7-9pm for the Stripe OA"): Discord channel -> Edit Channel -> Integrations -> Webhooks -> Copy Webhook URL. Empty = console only.
DISCORD_WEBHOOK_URL=

# Gmail polling
OABOT_POLL_SECONDS=15
OABOT_GMAIL_QUERY=newer_than:1d -category:promotions -category:social

# Treat a repeat email about the same OA or interview as a reminder (no new block). Set to 0 to schedule every email.
OABOT_DEDUPE=1
